# Get these from https://developer.spotify.com/dashboard after creating an app
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Must EXACTLY match a Redirect URI registered in your Spotify Dashboard app settings.
#
# Local development:
#   SPOTIFY_REDIRECT_URI=http://localhost:8888/auth/callback
#
# Render (or any HTTPS deployment) — Spotify requires HTTPS in production:
#   SPOTIFY_REDIRECT_URI=https://your-app-name.onrender.com/auth/callback
#
# Whichever value you use here MUST also be added, verbatim, as a Redirect URI
# in your Spotify Dashboard app settings, or login will fail with INVALID_CLIENT.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/auth/callback

# Locally this can be anything free. On Render, Render injects its own PORT
# value automatically — the server already reads process.env.PORT, so you
# generally don't need to set this yourself on Render.
PORT=8888

# --- Optional: LLM fallback for lyric fragments / badly garbled requests ---
# Leave unset to disable. The LLM only proposes title/artist guesses; every guess
# must still match a real Spotify track under a stricter confidence bar.
# ANTHROPIC_API_KEY=
# AKON_LLM_MODEL=claude-haiku-4-5
# AKON_LLM_TIMEOUT_MS=2500

# Spotify search page size per query (default 10).
# AKON_SEARCH_LIMIT=10
